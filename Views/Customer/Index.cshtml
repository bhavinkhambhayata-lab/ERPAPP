@model GetCustomerAddModel
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Customer Details";
}

<script src="~/lib/jquery/dist/jquery.min.js" asp-append-version="true"></script>
<script src="~/js/customer/add-customer.js" asp-append-version="true"></script>

<style>
    body {
        font-size: 13px;
        background: #f4f6f9;
    }

    .topbar {
        background: #0d6efd;
        color: #fff;
        padding: 10px 20px;
        font-size: 18px;
        font-weight: 600;
    }

    fieldset {
        border: 1px solid #d0d7de;
        border-radius: 6px;
        padding: 15px;
        background: #fff;
        margin-bottom: 15px;
    }

    legend {
        font-size: 14px;
        font-weight: 600;
        padding: 0 8px;
        color: #0d6efd;
    }

    .form-row {
        /* display: flex; */
        align-items: center;
        margin-bottom: 6px;
    }

    .form-label-custom {
        /* width: 45%; */
        font-weight: 500;
        padding-right: 6px;
    }

    .form-input-custom {
        /* width: 55%; */
    }

    .form-control, .form-select {
        height: 30px;
        font-size: 13px;
        padding: 3px 6px;
    }

    .action-buttons {
        text-align: center;
        padding: 20px 0;
    }

    .btn {
        font-size: 13px;
        padding: 6px 22px;
    }

</style>

<form asp-action="SaveCustomer" method="post">
    <div class="topbar">Customer Details</div>

    <div class="container-fluid mt-3">
        <div class="row">

            <!-- ================= LEFT SIDE ================= -->
            <div class="col-lg-6">

                <!-- ================= GENERAL ================= -->

                <fieldset>
                    <legend class="fw-bold">General Details</legend>

                    <!-- Portal Customer No -->
                    <div class="row align-items-center">
                        <div class="col-12 col-md-6">
                            <div class="row align-items-center">
                                <label class="col-12 col-sm-4 col-form-label">Portal Customer No</label>
                                <div class="col-12 col-sm-8">
                                    <input asp-for="PortalRowId" class="form-control" />
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-md-6"></div>
                    </div>

                    <!-- No + Brand -->
                    <div class="row align-items-center">

                        <div class="col-12 col-md-6">
                            <div class="row align-items-center">
                                <label class="col-12 col-sm-4 col-form-label">No</label>
                                <div class="col-12 col-sm-8">
                                    <input asp-for="DisplayNo" disabled class="form-control" />
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-md-6">
                            <div class="row align-items-center">
                                <label class="col-12 col-sm-4 col-form-label">Division</label>
                                <div class="col-12 col-sm-8">
                                    <select asp-for="Brand"
                                            asp-items="@(new SelectList(Model.CustomerDropDownModel.Brands, "RowID", "Name"))"
                                            class="form-select">
                                        <option value="">--Select--</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                    </div>

                    <!-- Name -->
                    <div class="row align-items-center mt-2">
                        <label class="col-12 col-sm-2 col-form-label">Name</label>
                        <div class="col-12 col-sm-10 position-relative">
                            <input asp-for="Name" class="form-control" autocomplete="off" />
                            <div id="customerSearchResult"
                                 class="list-group position-absolute w-100"
                                 style="z-index:800;max-height:250px;overflow-y:auto;">
                            </div>
                        </div>
                       @*  <div class="col-12 col-sm-2">
                            <input class="form-control" type="text" id="CustomerCode" name="CustomerCode" disabled>
                        </div> *@
                    </div>

                    <!-- Address -->
                    <div class="row align-items-center mt-2">
                        <label class="col-12 col-sm-2 col-form-label">Address</label>
                        <div class="col-12 col-sm-10">
                            <input asp-for="Address" class="form-control" />
                        </div>
                    </div>

                    <!-- Address 2 -->
                    <div class="row align-items-center mt-2">
                        <label class="col-12 col-sm-2 col-form-label">Address 2</label>
                        <div class="col-12 col-sm-10">
                            <input asp-for="Address2" class="form-control" />
                        </div>
                    </div>

                    <!-- City + Post Code -->
                    <div class="row align-items-center mt-2">

                        <div class="col-12 col-md-6">
                            <div class="row align-items-center">
                                <label class="col-12 col-sm-4 col-form-label">City</label>
                                <div class="col-12 col-sm-8">
                                    <select asp-for="City"
                                            asp-items="@(new SelectList(Model.CustomerDropDownModel.Cities, "Code", "Name"))"
                                            class="form-select">
                                        <option value="">--Select--</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-md-6">
                            <div class="row align-items-center">
                                <label class="col-12 col-sm-4 col-form-label">Post Code</label>
                                <div class="col-12 col-sm-8">
                                    <input asp-for="PostCode" class="form-control" />
                                </div>
                            </div>
                        </div>

                    </div>

                    <!-- State + Country -->
                    <div class="row align-items-center mt-2">

                        <div class="col-12 col-md-6">
                            <div class="row align-items-center">
                                <label class="col-12 col-sm-4 col-form-label">State</label>
                                <div class="col-12 col-sm-8">
                                    <input asp-for="StateCode" class="form-control" />
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-md-6">
                            <div class="row align-items-center">
                                <label class="col-12 col-sm-4 col-form-label">Country</label>
                                <div class="col-12 col-sm-8">
                                    <select asp-for="CountryCode"
                                            asp-items="@(new SelectList(Model.CustomerDropDownModel.Countries, "Code", "Name"))"
                                            class="form-select">
                                        <option value="">--Select--</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                    </div>

                    <!-- Region + Zone -->
                    <div class="row align-items-center mt-2">

                        <div class="col-12 col-md-6">
                            <div class="row align-items-center">
                                <label class="col-12 col-sm-4 col-form-label">Region</label>
                                <div class="col-12 col-sm-8">
                                    <select asp-for="Region"
                                            asp-items="@(new SelectList(Model.CustomerDropDownModel.Regions, "Code", "Name"))"
                                            class="form-select">
                                        <option value="">--Select--</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-md-6">
                            <div class="row align-items-center">
                                <label class="col-12 col-sm-4 col-form-label">Zone</label>
                                <div class="col-12 col-sm-8">
                                    <select asp-for="Zone"
                                            asp-items="@(new SelectList(Model.CustomerDropDownModel.Zones, "Code", "Name"))"
                                            class="form-select">
                                        <option value="">--Select--</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                    </div>

                    <!-- Contact Person + Mobile -->
                    <div class="row align-items-center mt-2">

                        <div class="col-12 col-md-6">
                            <div class="row align-items-center">
                                <label class="col-12 col-sm-4 col-form-label">Contact Person</label>
                                <div class="col-12 col-sm-8">
                                    <input asp-for="ContactPerson" class="form-control" />
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-md-6">
                            <div class="row align-items-center">
                                <label class="col-12 col-sm-4 col-form-label">Mobile No</label>
                                <div class="col-12 col-sm-8">
                                    <input asp-for="MobileNo" class="form-control" />
                                </div>
                            </div>
                        </div>

                    </div>

                    <!-- Phone + Email -->
                    <div class="row align-items-center mt-2">

                        <div class="col-12 col-md-6">
                            <div class="row align-items-center">
                                <label class="col-12 col-sm-4 col-form-label">Phone No</label>
                                <div class="col-12 col-sm-8">
                                    <input asp-for="PhoneNo" class="form-control" />
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-md-6">
                            <div class="row align-items-center">
                                <label class="col-12 col-sm-4 col-form-label">Email</label>
                                <div class="col-12 col-sm-8">
                                    <input asp-for="Email" class="form-control" />
                                </div>
                            </div>
                        </div>

                    </div>

                    <!-- E_INV Phone + E_INV Email -->
                    <div class="row align-items-center mt-2">

                        <div class="col-12 col-md-6">
                            <div class="row align-items-center">
                                <label class="col-12 col-sm-4 col-form-label">E_INV Phone</label>
                                <div class="col-12 col-sm-8">
                                    <input asp-for="EInvPhoneNo" class="form-control" />
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-md-6">
                            <div class="row align-items-center">
                                <label class="col-12 col-sm-4 col-form-label">E_INV Email</label>
                                <div class="col-12 col-sm-8">
                                    <input asp-for="EInvEmail" class="form-control" />
                                </div>
                            </div>
                        </div>

                    </div>

                    <!-- Website + Fax -->
                    <div class="row align-items-center mt-2">

                        <div class="col-12 col-md-6">
                            <div class="row align-items-center">
                                <label class="col-12 col-sm-4 col-form-label">Website</label>
                                <div class="col-12 col-sm-8">
                                    <input asp-for="Website" class="form-control" />
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-md-6">
                            <div class="row align-items-center">
                                <label class="col-12 col-sm-4 col-form-label">Fax</label>
                                <div class="col-12 col-sm-8">
                                    <input asp-for="FaxNo" class="form-control" />
                                </div>
                            </div>
                        </div>

                    </div>

                </fieldset>

                <!-- ================= TAX & BANK ================= -->
                <fieldset>
                    <legend class="fw-bold">Tax, Bank & Commission</legend>

                    <!-- GST Reg Type + GST Cust Type -->
                    <div class="row align-items-center mt-2">
                        <div class="col-12 col-md-6">
                            <div class="row align-items-center">
                                <label class="col-12 col-sm-4 col-form-label">GST Reg Type</label>
                                <div class="col-12 col-sm-8">
                                    <input asp-for="GSTRegistrationType" type="number" class="form-control" />
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-md-6">
                            <div class="row align-items-center">
                                <label class="col-12 col-sm-4 col-form-label">GST Cust Type</label>
                                <div class="col-12 col-sm-8">
                                    <input asp-for="GSTCustomerType" type="number" class="form-control" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- GST Reg No + ARN No -->
                    <div class="row align-items-center mt-2">
                        <div class="col-12 col-md-6">
                            <div class="row align-items-center">
                                <label class="col-12 col-sm-4 col-form-label">GST Reg No</label>
                                <div class="col-12 col-sm-8">
                                    <input asp-for="GSTRegistrationNo" class="form-control" />
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-md-6">
                            <div class="row align-items-center">
                                <label class="col-12 col-sm-4 col-form-label">ARN No</label>
                                <div class="col-12 col-sm-8">
                                    <input asp-for="ARNNo" class="form-control" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- PAN No + Bank Name -->
                    <div class="row align-items-center mt-2">
                        <div class="col-12 col-md-6">
                            <div class="row align-items-center">
                                <label class="col-12 col-sm-4 col-form-label">PAN No</label>
                                <div class="col-12 col-sm-8">
                                    <input asp-for="PANNo" class="form-control" />
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-md-6">
                            <div class="row align-items-center">
                                <label class="col-12 col-sm-4 col-form-label">Bank Name</label>
                                <div class="col-12 col-sm-8">
                                    <input asp-for="BankName" class="form-control" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Bank Account No + Branch Name -->
                    <div class="row align-items-center mt-2">
                        <div class="col-12 col-md-6">
                            <div class="row align-items-center">
                                <label class="col-12 col-sm-4 col-form-label">Bank Account No</label>
                                <div class="col-12 col-sm-8">
                                    <input asp-for="BankAccountNo" class="form-control" />
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-md-6">
                            <div class="row align-items-center">
                                <label class="col-12 col-sm-4 col-form-label">Branch Name</label>
                                <div class="col-12 col-sm-8">
                                    <input asp-for="BranchName" class="form-control" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- IFSC Code + Commission Type -->
                    <div class="row align-items-center mt-2">
                        <div class="col-12 col-md-6">
                            <div class="row align-items-center">
                                <label class="col-12 col-sm-4 col-form-label">IFSC Code</label>
                                <div class="col-12 col-sm-8">
                                    <input asp-for="IFSCCode" class="form-control" />
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-md-6">
                            <div class="row align-items-center">
                                <label class="col-12 col-sm-4 col-form-label">Commission Type</label>
                                <div class="col-12 col-sm-8">
                                    <input asp-for="CommissionType" type="number" class="form-control" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Commission Value + Currency -->
                    <div class="row align-items-center mt-2">
                        <div class="col-12 col-md-6">
                            <div class="row align-items-center">
                                <label class="col-12 col-sm-4 col-form-label">Commission % / Rs</label>
                                <div class="col-12 col-sm-8">
                                    <input asp-for="CommissionValue" type="number" step="0.01" class="form-control" />
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-md-6">
                            <div class="row align-items-center">
                                <label class="col-12 col-sm-4 col-form-label">Currency</label>
                                <div class="col-12 col-sm-8">
                                    <select asp-for="CurrencyCode"
                                            asp-items="@(new SelectList(Model.CustomerDropDownModel.Currencies, "Code", "Name"))"
                                            class="form-select">
                                        <option value="">--Select--</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Vendor (Full Width) -->
                    <div class="row align-items-center mt-2">
                        <label class="col-12 col-sm-2 col-form-label">Vendor</label>
                        <div class="col-12 col-sm-10">
                            <select asp-for="VendorCode"
                                    asp-items="@(new SelectList(Model.CustomerDropDownModel.Vendors, "Code", "Name"))"
                                    class="form-select">
                                <option value="">--Select--</option>
                            </select>
                        </div>
                    </div>

                    <!-- Parent Customer (Full Width) -->
                    <div class="row align-items-center mt-2">
                        <label class="col-12 col-sm-2 col-form-label">Parent Customer</label>
                        <div class="col-12 col-sm-10">
                            <select asp-for="ParentCustomerCode"
                                    asp-items="@(new SelectList(Model.CustomerDropDownModel.ParentCustomers, "Code", "Name"))"
                                    class="form-select">
                                <option value="">--Select--</option>
                            </select>
                        </div>
                    </div>

                    <!-- Dealer Appt Date + Dealer Classification -->
                    <div class="row align-items-center mt-2">
                        <div class="col-12 col-md-6">
                            <div class="row align-items-center">
                                <label class="col-12 col-sm-4 col-form-label">Dealer Appt Date</label>
                                <div class="col-12 col-sm-8">
                                    <input asp-for="DealerAppointmentDate" type="date" class="form-control" />
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-md-6">
                            <div class="row align-items-center">
                                <label class="col-12 col-sm-4 col-form-label">Dealer Classification</label>
                                <div class="col-12 col-sm-8">
                                    <input asp-for="DealerClassification" type="number" class="form-control" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Customer Category + HO Sales -->
                    <div class="row align-items-center mt-2">
                        <div class="col-12 col-md-6">
                            <div class="row align-items-center">
                                <label class="col-12 col-sm-4 col-form-label">Customer Category</label>
                                <div class="col-12 col-sm-8">
                                    <select asp-for="CustomerCategoryCode"
                                            asp-items="@(new SelectList(Model.CustomerDropDownModel.CustomerCategories, "Code", "Name"))"
                                            class="form-select">
                                        <option value="">--Select--</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-md-6">
                            <div class="row align-items-center">
                                <label class="col-12 col-sm-4 col-form-label">HO Sales</label>
                                <div class="col-12 col-sm-8">
                                    <select asp-for="HOSalesCode"
                                            asp-items="@(new SelectList(Model.CustomerDropDownModel.HOSalesPersons, "Code", "Name"))"
                                            class="form-select">
                                        <option value="">--Select--</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>

                </fieldset>

            </div>

            <!-- ================= RIGHT SIDE ================= -->
            <div class="col-lg-6">

                <!-- ================= NOD/NOC ================= -->

                <fieldset>
                    <legend class="fw-bold">NOD / NOC</legend>

                    <!-- NOD/NOC Creation + Access Code -->
                    <div class="row align-items-center mt-2">
                        <div class="col-12 col-md-6">
                            <div class="row align-items-center">
                                <label class="col-12 col-sm-4 col-form-label">NOD/NOC Creation</label>
                                <div class="col-12 col-sm-8">
                                    <select asp-for="IsNodNocCreation" class="form-select">
                                        <option value="">-- Select --</option>
                                        <option value="true">Yes</option>
                                        <option value="false">No</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-md-6">
                            <div class="row align-items-center">
                                <label class="col-12 col-sm-4 col-form-label">Access Code</label>
                                <div class="col-12 col-sm-8">
                                    <input asp-for="NODAccessCode" class="form-control" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- NOD/NOC (Full Width) -->
                    <div class="row align-items-center mt-2">
                        <label class="col-12 col-sm-2 col-form-label">NOD/NOC</label>
                        <div class="col-12 col-sm-10">
                            <select asp-for="NODNOC"
                                    asp-items="@(new SelectList(Model.CustomerDropDownModel.NODNOCs, "Code", "Name"))"
                                    class="form-select">
                                <option value="">--Select--</option>
                            </select>
                        </div>
                    </div>

                    <!-- Concessional Code (Full Width) -->
                    <div class="row align-items-center mt-2">
                        <label class="col-12 col-sm-2 col-form-label">Concessional Code</label>
                        <div class="col-12 col-sm-10">
                            <select asp-for="ConcessionalCode"
                                    asp-items="@(new SelectList(Model.CustomerDropDownModel.ConcessionalCodes, "Code", "Name"))"
                                    class="form-select">
                                <option value="">--Select--</option>
                            </select>
                        </div>
                    </div>

                    <!-- Threshold Overlook + Surcharge Overlook -->
                    <div class="row align-items-center mt-2">
                        <div class="col-12 col-md-6">
                            <div class="row align-items-center">
                                <label class="col-12 col-sm-4 col-form-label">Threshold Overlook</label>
                                <div class="col-12 col-sm-8 d-flex align-items-center">
                                    <div class="form-check m-0">
                                        <input asp-for="ThresholdOverlook" class="form-check-input" />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-md-6">
                            <div class="row align-items-center">
                                <label class="col-12 col-sm-4 col-form-label">Surcharge Overlook</label>
                                <div class="col-12 col-sm-8 d-flex align-items-center">
                                    <div class="form-check m-0">
                                        <input asp-for="SurchargeOverlook" class="form-check-input" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                </fieldset>


                <!-- ================= BUSINESS ================= -->
                <fieldset>
                    <legend class="fw-bold">Business Details</legend>

                    <!-- Customer Type + Credit Limit -->
                    <div class="row align-items-center mt-2">
                        <div class="col-12 col-md-6">
                            <div class="row align-items-center">
                                <label class="col-12 col-sm-4 col-form-label">Customer Type</label>
                                <div class="col-12 col-sm-8">
                                    <input asp-for="CustomerType" type="number" class="form-control" />
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-md-6">
                            <div class="row align-items-center">
                                <label class="col-12 col-sm-4 col-form-label">Credit Limit</label>
                                <div class="col-12 col-sm-8">
                                    <input asp-for="CreditLimit" type="number" step="0.01" class="form-control" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Payment Terms + Payment Method -->
                    <div class="row align-items-center mt-2">
                        <div class="col-12 col-md-6">
                            <div class="row align-items-center">
                                <label class="col-12 col-sm-4 col-form-label">Payment Terms</label>
                                <div class="col-12 col-sm-8">
                                    <select asp-for="PaymentTermsCode"
                                            asp-items="@(new SelectList(Model.CustomerDropDownModel.PaymentTerms, "Code", "Name"))"
                                            class="form-select">
                                        <option value="">--Select--</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-md-6">
                            <div class="row align-items-center">
                                <label class="col-12 col-sm-4 col-form-label">Payment Method</label>
                                <div class="col-12 col-sm-8">
                                    <select asp-for="PaymentMethodCode"
                                            asp-items="@(new SelectList(Model.CustomerDropDownModel.PaymentMethods, "Code", "Name"))"
                                            class="form-select">
                                        <option value="">--Select--</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Salesperson + Allocation -->
                    <div class="row align-items-center mt-2">
                        <div class="col-12 col-md-6">
                            <div class="row align-items-center">
                                <label class="col-12 col-sm-4 col-form-label">Salesperson</label>
                                <div class="col-12 col-sm-8">
                                    <select asp-for="SalespersonCode"
                                            asp-items="@(new SelectList(Model.CustomerDropDownModel.SalesPersons, "Code", "Name"))"
                                            class="form-select">
                                        <option value="">--Select--</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-md-6">
                            <div class="row align-items-center">
                                <label class="col-12 col-sm-4 col-form-label">Allocation</label>
                                <div class="col-12 col-sm-8">
                                    <input asp-for="Allocation" class="form-control" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Structure + Business Category -->
                    <div class="row align-items-center mt-2">
                        <div class="col-12 col-md-6">
                            <div class="row align-items-center">
                                <label class="col-12 col-sm-4 col-form-label">Structure</label>
                                <div class="col-12 col-sm-8">
                                    <select asp-for="Structure"
                                            asp-items="@(new SelectList(Model.CustomerDropDownModel.Structures, "Code", "Name"))"
                                            class="form-select">
                                        <option value="">--Select--</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-md-6">
                            <div class="row align-items-center">
                                <label class="col-12 col-sm-4 col-form-label">Business Category</label>
                                <div class="col-12 col-sm-8">
                                    <input asp-for="BusinessCategory" type="number" class="form-control" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Location + Price List -->
                    <div class="row align-items-center mt-2">
                        <div class="col-12 col-md-6">
                            <div class="row align-items-center">
                                <label class="col-12 col-sm-4 col-form-label">Location</label>
                                <div class="col-12 col-sm-8">
                                    <select asp-for="LocationCode"
                                            asp-items="@(new SelectList(Model.CustomerDropDownModel.Locations, "Code", "Name"))"
                                            class="form-select">
                                        <option value="">--Select--</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-md-6">
                            <div class="row align-items-center">
                                <label class="col-12 col-sm-4 col-form-label">Price List</label>
                                <div class="col-12 col-sm-8">
                                    <select asp-for="PriceListCode"
                                            asp-items="@(new SelectList(Model.CustomerDropDownModel.PriceLists, "Code", "Name"))"
                                            class="form-select">
                                        <option value="">--Select--</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Customer Price Group + MRP Group -->
                    <div class="row align-items-center mt-2">
                        <div class="col-12 col-md-6">
                            <div class="row align-items-center">
                                <label class="col-12 col-sm-4 col-form-label">Customer Price Group</label>
                                <div class="col-12 col-sm-8">
                                    <select asp-for="CustomerPriceGroup"
                                            asp-items="@(new SelectList(Model.CustomerDropDownModel.CustomerPriceGroups, "Code", "Name"))"
                                            class="form-select">
                                        <option value="">--Select--</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-md-6">
                            <div class="row align-items-center">
                                <label class="col-12 col-sm-4 col-form-label">MRP Group</label>
                                <div class="col-12 col-sm-8">
                                    <input asp-for="MRPGroup" class="form-control" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Customer Posting Group + Gen Bus Posting Group -->
                    <div class="row align-items-center mt-2">
                        <div class="col-12 col-md-6">
                            <div class="row align-items-center">
                                <label class="col-12 col-sm-4 col-form-label">Customer Posting Group</label>
                                <div class="col-12 col-sm-8">
                                    <select asp-for="CustomerPostingGroup"
                                            asp-items="@(new SelectList(Model.CustomerDropDownModel.CustomerPostingGroups, "Code", "Name"))"
                                            class="form-select">
                                        <option value="">--Select--</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-md-6">
                            <div class="row align-items-center">
                                <label class="col-12 col-sm-4 col-form-label">Gen Bus Posting Group</label>
                                <div class="col-12 col-sm-8">
                                    <select asp-for="GenBusPostingGroup"
                                            asp-items="@(new SelectList(Model.CustomerDropDownModel.GenBusPostingGroups, "Code", "Name"))"
                                            class="form-select">
                                        <option value="">--Select--</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Excise Bus Posting Group + Application Method -->
                    <div class="row align-items-center mt-2">
                        <div class="col-12 col-md-6">
                            <div class="row align-items-center">
                                <label class="col-12 col-sm-4 col-form-label">Excise Bus Posting Group</label>
                                <div class="col-12 col-sm-8">
                                    <select asp-for="ExciseBusPostingGroup"
                                            asp-items="@(new SelectList(Model.CustomerDropDownModel.ExciseBusPostingGroups, "Code", "Name"))"
                                            class="form-select">
                                        <option value="">--Select--</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-md-6">
                            <div class="row align-items-center">
                                <label class="col-12 col-sm-4 col-form-label">Application Method</label>
                                <div class="col-12 col-sm-8">
                                    <input asp-for="ApplicationMethod" type="number" class="form-control" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Tax Liable + Dimension -->
                    <div class="row align-items-center mt-2">
                        <div class="col-12 col-md-6">
                            <div class="row align-items-center">
                                <label class="col-12 col-sm-4 col-form-label">Tax Liable</label>
                                <div class="col-12 col-sm-8">
                                    <select asp-for="TaxLiable" class="form-select">
                                        <option value="true">YES</option>
                                        <option value="false">NO</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-md-6">
                            <div class="row align-items-center">
                                <label class="col-12 col-sm-4 col-form-label">Dimension</label>
                                <div class="col-12 col-sm-8">
                                    <input asp-for="Dimension" class="form-control" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- MSME UAM No (Single Left) -->
                    <div class="row align-items-center mt-2">
                        <div class="col-12 col-md-6">
                            <div class="row align-items-center">
                                <label class="col-12 col-sm-4 col-form-label">MSME UAM No</label>
                                <div class="col-12 col-sm-8">
                                    <input asp-for="MSMEUAMNo" class="form-control" />
                                </div>
                            </div>
                        </div>
                    </div>

                </fieldset>

                <div class="action-buttons">
                    <button type="submit" class="btn btn-primary">Save</button>
                    <button type="reset" class="btn btn-secondary">Refresh</button>
                </div>

            </div>

        </div>
    </div>
</form>