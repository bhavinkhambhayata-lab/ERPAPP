
<script src="~/lib/jquery/dist/jquery.min.js" asp-append-version="true"></script>

<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

<div class="container-fluid mt-1">

    <div class="row">
        <div class="col-lg-12">

            <!-- 🔥 TITLE -->
            <h4 class="mb-3 fw-semibold">Customer Management</h4>

            <!-- 🔥 TABS -->
            <ul class="nav nav-tabs">

                <li class="nav-item">
                    <button class="nav-link active" id="detailsBtn" data-bs-toggle="tab" data-bs-target="#detailsTab">
                        Details
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link " id="listBtn" data-bs-toggle="tab" data-bs-target="#listTab">
                        List
                    </button>
                </li>
            </ul>
            <!-- Content -->
            <div class="mt-3" id="tabContent">
            </div>
        </div>
    </div>

</div>

<script>
    var editCustomerNo='';
     var editCustomerBlock='0';
        $(document).ready(function () {

        // Default load
        loadDetails();

        $("#listBtn").click(function () {
            loadList();
        });

        $("#detailsBtn").click(function () {
            
            //editCustomerBlock="3";
            if(editCustomerNo!='' && editCustomerBlock == "0")
            {
                 $.ajax({
                            url: baseURL + 'Customer/GetCustomerEditData',
                            type: 'GET',
                            data: { customerNo: editCustomerNo },
                            success: function (response) {
                                $('#tabContent').html(response);
                            },
                            error: function () {
                                alert('Error loading customer details');
                            }
                        });
            }
             else if(editCustomerNo!='' && editCustomerBlock == "3")
             {
                 $.ajax({
                            url: baseURL + 'Customer/GetCustomerUnBlockEditData',
                            type: 'GET',
                            data: { customerNo: editCustomerNo },
                            success: function (response) {
                                $('#tabContent').html(response);
                            },
                            error: function () {
                                alert('Error loading customer details');
                            }
                        });
             }
            else
            {
                loadDetails();
            }
        });

        function loadList() {
            editCustomerNo='';
            editCustomerBlock='0';
            $.get(baseURL +'Customer/CustomerList', function (data) {
                $("#tabContent").html(data);
            });
        }

        function loadDetails() {
            editCustomerNo='';
            editCustomerBlock='0';
            $.get(baseURL +'Customer/AddEditCustomer', function (data) {
                $("#tabContent").html(data);
            });
        }

    });
</script>

