
<script src="~/lib/jquery/dist/jquery.min.js" asp-append-version="true"></script>

<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

<div class="container-fluid mt-1">

    <div class="row">
        <div class="col-lg-12">

            <!-- 🔥 TITLE -->
            <h4 class="mb-3 fw-semibold">FG Item Management</h4>

            <!-- 🔥 TABS -->
            <ul class="nav nav-tabs">

                <li class="nav-item">
                    <button class="nav-link active" id="detailsBtn" data-bs-toggle="tab" data-bs-target="#detailsTab">
                        Details
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link " id="listBtn" data-bs-toggle="tab" data-bs-target="#listTab">
                        List
                    </button>
                </li>
            </ul>
            <!-- Content -->
            <div class="mt-3" id="tabContent">
            </div>
        </div>
    </div>

</div>

<script>
    var getFGItemEditModel='';

            $(document).ready(function () {

            // Default load
            loadDetails();

            $("#listBtn").click(function () {
                //loadList();
            });

            $("#detailsBtn").click(function () {

                $("#tabContent").html('');
                       // jo edit model hoy to Edit page load karse
                if (getFGItemEditModel != null && getFGItemEditModel != '') {

                    editFGItemPageLoad(getFGItemEditModel);
                    getFGItemEditModel='';
                }
                else {

                    // normal Add page load karse
                    loadDetails();
                    getFGItemEditModel='';
                }
            });

            function loadList() {

                // $.get(baseURL +'Customer/CustomerList', function (data) {
                //     $("#tabContent").html(data);
                // });
            }

            function loadDetails() {
                $.get(baseURL +'FGItem/AddFGItem', function (data) {
                    $("#tabContent").html(data);
                });
            }

            function editFGItemPageLoad(model) {
                    //$("#tabContent").html('');
                    
                     showLoader();
                    $.ajax({
                        url: baseURL + 'FGItem/EditFGItem',
                        type: 'POST',
                        data: model,
                        success: function (partialView) {
                            hideLoader();
                            $("#tabContent").html(partialView);
                        },
                        error: function () {
                            hideLoader();
                            toastr.error("Failed to load item data.");
                        }
                    });
        }

        });
</script>

