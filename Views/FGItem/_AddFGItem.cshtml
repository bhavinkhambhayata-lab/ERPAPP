                    </div>
                </div>


                <!-- Column 2 -->
                <div class="col-4">
                    <!-- GST Group Code-->
                    <div class="row mt-2">
                        <label class="col-12 col-sm-4 col-form-label">GST Group Code<span class="required-star">*</span></label>
