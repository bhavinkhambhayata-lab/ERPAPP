@model GetFGItemAddModel
@using Microsoft.AspNetCore.Mvc.Rendering
@using static ERPAPP.Helper.Enums
@{
    ViewData["Title"] = "FG Item Details";
}

<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

<script src="~/js/fgitem/fg-items.js" asp-append-version="true"></script>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">

<style>
    body {
        font-size: 13px;
        background: #f4f6f9;
    }

    .topbar {
        background: #0d6efd;
        color: #fff;
        padding: 10px 20px;
        font-size: 18px;
        font-weight: 600;
    }

    fieldset {
        border: 1px solid #d0d7de;
        border-radius: 6px;
        padding: 15px;
        background: #fff;
        margin-bottom: 15px;
    }

    legend {
        font-size: 14px;
        font-weight: 600;
        padding: 0 8px;
        color: #0d6efd;
    }

    .form-row {
        /* display: flex; */
        align-items: center;
        margin-bottom: 6px;
    }

    .form-label-custom {
        /* width: 45%; */
        font-weight: 500;
        padding-right: 6px;
    }

    .form-input-custom {
        /* width: 55%; */
    }

    .form-control, .form-select {
        height: 30px;
        font-size: 13px;
        padding: 3px 6px;
    }

    .action-buttons {
        text-align: center;
        padding: 20px 0;
    }

    .btn {
        font-size: 13px;
        padding: 6px 22px;
    }

    .required-star {
        color: red;
        font-size: 13px;
    }

    #brandTable thead th {
        text-align: center;
        vertical-align: middle;
    }

    .brand-error-field {
        border: 2px solid red !important;
    }

    .customer-textarea {
        height: 60px;
    }

    .portal-bind-data {
        border-color: green !important;
        box-shadow: 0 0 0 0.2rem rgba(0, 128, 0, 0.25);
    }

    .table-responsive {
        overflow-x: auto; /* horizontal scroll */
    }

    #brandTable {
        width: max-content; /* table expand thase */
        min-width: 100%; /* minimum full width */
    }

        #brandTable th,
        #brandTable td {
            white-space: nowrap; /* text ek line ma */
            min-width: 120px; /* column squeeze na thay */
        }


    /* --------------Drop Down Related changes-----------------*/
    .select2-container--bootstrap-5 .select2-selection {
        height: 32px !important;
        min-height: 32px;
        padding: 0.25rem 0.75rem;
        border: 1px solid #ced4da;
        border-radius: 0.375rem;
        display: flex;
        align-items: center;
    }


    .select2-container--bootstrap-5 .select2-selection__rendered {
        line-height: 20px !important;
        padding-left: 0 !important;
    }


    .select2-container--bootstrap-5 .select2-selection__arrow {
        height: 100%;
        right: 10px;
    }

    .select2-container {
        width: 100% !important;
    }
    /* ----------------------------------------------------------- */



    .grade-card {
        width: 100%;
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 8px 10px;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        background: #f8f9fb;
        cursor: pointer;
        transition: all 0.2s ease;
        min-height: 38px;
    }

        .grade-card:hover {
            border-color: #0d6efd;
            background: #eef4ff;
        }

        .grade-card input[type="checkbox"] {
            cursor: pointer;
            transform: scale(0.95);
            margin-top: 0;
        }

    .grade-text {
        font-size: 13px;
        font-weight: 600;
        color: #2c2f33;
    }

    #btnPreviewGrades {
        border-radius: 6px;
        font-weight: 600;
        min-width: 100px;
        height: 36px;
        font-size: 13px;
    }
</style>

<form id="FGItemForm" method="post">

    <div class="topbar d-flex justify-content-between align-items-center">
        <div class="fw-bold">
            FG Item Details
        </div>

        <div class="fw-bold">
            Row Unique ID : <span class="fw-semibold" id="DisplayNo">@Model.DisplayNo</span>
        </div>
        <input type="hidden" id="IsAlreadyCreatedMaster" value="0" />
    </div>

    <div class="container-fluid mt-3">

        <!-- ================= Basic Information ================= -->
        <fieldset>
            <legend class="fw-bold">Basic Information</legend>

            <div class="row">
                <div class="col-4">
                    <!-- Description -->
                    <div class="row mt-2">
                        <label class="col-12 col-sm-4 col-form-label">
                            Description<span class="required-star">*</span>
                        </label>
                        <div class="col-12 col-sm-8 position-relative">
                            <input asp-for="Description" class="form-control" />
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>
                    </div>

                    <!-- Description 2 -->
                    <div class="row mt-2">
                        <label class="col-12 col-sm-4 col-form-label">
                            Description 2<span class="required-star">*</span>
                        </label>
                        <div class="col-12 col-sm-8 position-relative">
                            <input asp-for="Description2" class="form-control" />
                            <span asp-validation-for="Description2" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="col-4">
                    <!-- Size Of Tile -->
                    <div class="row mt-2">
                        <label class="col-12 col-sm-4 col-form-label">Size Of Tile<span class="required-star">*</span></label>
                        <div class="col-12 col-sm-8">
                            <select asp-for="SizeOfTile"
                                    asp-items="@(new SelectList(Model.DropDownData.SizeOfTiles, "Code", "Name"))"
                                    class="form-select">
                                <option value="">-- Select --</option>
                            </select>
                            <span asp-validation-for="SizeOfTile" class="text-danger"></span>
                        </div>
                    </div>

                    <!-- Category -->
                    <div class="row mt-2">
                        <label class="col-12 col-sm-4 col-form-label">Category<span class="required-star">*</span></label>
                        <div class="col-12 col-sm-8">
                            <select asp-for="Category"
                                    asp-items="@(new SelectList(Model.DropDownData.Categories, "Code", "Name"))"
                                    class="form-select">
                                <option value="">-- Select --</option>
                            </select>
                            <span asp-validation-for="Category" class="text-danger"></span>
                        </div>
                    </div>


                </div>

                <div class="col-4">
                    <!-- Packaging -->
                    <div class="row mt-2">
                        <label class="col-12 col-sm-4 col-form-label">Packaging<span class="required-star">*</span></label>
                        <div class="col-12 col-sm-8">
                            <select asp-for="Packaging"
                                    asp-items="@(new SelectList(Model.DropDownData.Packagings, "Code", "Name"))"
                                    class="form-select">
                                <option value="">-- Select --</option>
                            </select>
                            <span asp-validation-for="Packaging" class="text-danger"></span>
                        </div>
                    </div>

                    <!-- Thickness -->
                    <div class="row mt-2">
                        <label class="col-12 col-sm-4 col-form-label">Thickness<span class="required-star">*</span></label>
                        <div class="col-12 col-sm-8">
                            <select asp-for="Thickness"
                                    asp-items="@(new SelectList(Model.DropDownData.Thicknesses, "Code", "Name"))"
                                    class="form-select">
                                <option value="">-- Select --</option>
                            </select>
                            <span asp-validation-for="Thickness" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row mt-3">
                <div class="col-12 text-end">
                    <button type="button"
                            id="btnCheckInERP"
                            class="btn btn-primary">
                        Check In ERP
                    </button>
                </div>
            </div>
        </fieldset>

        <!-- ================= General ================= -->
        <fieldset id="generalDetailsFieldset">
            <legend class="fw-bold">General Details</legend>

            <div class="row">

                <!-- Column 1 -->
                <div class="col-4">

                    <!-- Rounding Precision -->
                    <div class="row mt-2">
                        <label class="col-12 col-sm-4 col-form-label">
                            Rounding Precision<span class="required-star">*</span>
                        </label>
                        <div class="col-12 col-sm-8">
                            <input asp-for="RoundingPrecision" class="form-control" />
                            <span asp-validation-for="RoundingPrecision" class="text-danger"></span>
                        </div>
                    </div>

                    <!-- Unit Of Measure -->
                    <div class="row mt-2">
                        <label class="col-12 col-sm-4 col-form-label">Base Unit Of Measure<span class="required-star">*</span></label>
                        <div class="col-12 col-sm-8">
                            <select asp-for="BaseUnitOfMeasure"
                                    asp-items="@(new SelectList(Model.DropDownData.UnitOfMeasures, "Code", "Name"))"
                                    class="form-select">
                                <option value="">-- Select --</option>
                            </select>
                            <span asp-validation-for="BaseUnitOfMeasure" class="text-danger"></span>
                        </div>
                    </div>

                    <!-- Movement -->
                    <div class="row mt-2">
                        <label class="col-12 col-sm-4 col-form-label">Movement<span class="required-star">*</span></label>
                        <div class="col-12 col-sm-8">
                            <select asp-for="MovementType"
                                    asp-items="@(new SelectList(Model.DropDownData.MovementTypes, "Code", "Name"))"
                                    class="form-select">
                                <option value="">-- Select --</option>
                            </select>
                            <span asp-validation-for="MovementType" class="text-danger"></span>
                        </div>
                    </div>

                    @* <!-- Item Category -->
                    <div class="row mt-2">
                        <label class="col-12 col-sm-4 col-form-label">Item Category</label>
                        <div class="col-12 col-sm-8">
                            <select asp-for="ItemCategoryCode" class="form-select">

                                <option value="">-- Select --</option>

                                @if (Model.DropDownData.ItemCategories != null)
                                {
                                    foreach (var item in Model.DropDownData.ItemCategories)
                                    {
                                        <option value="@item.Code"
                                                data-costingmethod="@item.CostingMethod"
                                                data-inventorypostinggroup="@item.InventoryPostingGroup"
                                                data-genprodpostinggroup="@item.GenProdPostingGroup">

                                            @item.Name
                                        </option>
                                    }
                                }
                            </select>
                            <span asp-validation-for="ItemCategoryCode" class="text-danger"></span>
                        </div>
                    </div> *@

                </div>

                <!-- Column 2 -->
                <div class="col-4">
                    <!-- General Product Posting Group -->
                    <div class="row mt-2">
                        <label class="col-12 col-sm-4 col-form-label"> Gen Product Posting Group<span class="required-star">*</span></label>
                        <div class="col-12 col-sm-8">
                            <select asp-for="GenProdPostingGroup"
                                    asp-items="@(new SelectList(Model.DropDownData.GeneralProductPostingGroups, "Code", "Name"))"
                                    class="form-select">
                                <option value="">-- Select --</option>
                            </select>
                            <span asp-validation-for="GenProdPostingGroup" class="text-danger"></span>
                        </div>
                    </div>
                    @* <!-- Production BOM No -->
                    <div class="row mt-2">
                        <label class="col-12 col-sm-4 col-form-label">Production BOM No</label>
                        <div class="col-12 col-sm-8">
                            <select asp-for="ProductionBOMNo" class="form-select">
                                <option value="">-- Select --</option>
                            </select>
                            <span asp-validation-for="ProductionBOMNo" class="text-danger"></span>
                        </div>
                    </div>

                    <!-- Routing No -->
                    <div class="row mt-2">
                        <label class="col-12 col-sm-4 col-form-label">Routing No</label>
                        <div class="col-12 col-sm-8">
                            <select asp-for="RoutingNo"
                                    asp-items="@(new SelectList(Model.DropDownData.RoutingNos, "Code", "Name"))"
                                    class="form-select">
                                <option value="">-- Select --</option>
                            </select>
                            <span asp-validation-for="RoutingNo" class="text-danger"></span>
                        </div>
                    </div> *@

                    <!-- ManufacturingPolicy -->
                    <div class="row mt-2">
                        <label class="col-12 col-sm-4 col-form-label">Manufacturing Policy<span class="required-star">*</span></label>
                        <div class="col-12 col-sm-8">
                            <select asp-for="ManufacturingPolicy"
                                    asp-items="@(new SelectList(Model.DropDownData.ManufacturingPolicies, "Code", "Name"))"
                                    class="form-select">
                                <option value="">-- Select --</option>
                            </select>
                            <span asp-validation-for="ManufacturingPolicy" class="text-danger"></span>
                        </div>
                    </div>

                    <!-- Replenishment System -->
                    <div class="row mt-2">
                        <label class="col-12 col-sm-4 col-form-label">Replenishment System<span class="required-star">*</span></label>
                        <div class="col-12 col-sm-8">
                            <select asp-for="ReplenishmentSystem"
                                    asp-items="@(new SelectList(Model.DropDownData.ReplenishmentSystems, "Code", "Name"))"
                                    class="form-select">
                                <option value="">-- Select --</option>
                            </select>
                            <span asp-validation-for="ReplenishmentSystem" class="text-danger"></span>
                        </div>
                    </div>

                    <!-- Reordering Policy -->
                    <div class="row mt-2">
                        <label class="col-12 col-sm-4 col-form-label">Reorderring Policy<span class="required-star">*</span></label>
                        <div class="col-12 col-sm-8">
                            <select asp-for="ReorderingPolicy"
                                    asp-items="@(new SelectList(Model.DropDownData.ReorderingPolicy, "Code", "Name"))"
                                    class="form-select">
                                <option value="">-- Select --</option>
                            </select>
                            <span asp-validation-for="ReorderingPolicy" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <!-- Column 3 -->
                <div class="col-4">
                    <!-- Gross Weight -->
                    <div class="row mt-2">
                        <label class="col-12 col-sm-4 col-form-label">
                            Gross Weight
                        </label>
                        <div class="col-12 col-sm-8">
                            <input asp-for="GrossWeight" class="form-control" />
                            <span asp-validation-for="GrossWeight" class="text-danger"></span>
                        </div>
                    </div>

                    <!-- Net Weight -->
                    <div class="row mt-2">
                        <label class="col-12 col-sm-4 col-form-label">
                            Net Weight
                        </label>
                        <div class="col-12 col-sm-8">
                            <input asp-for="NetWeight" class="form-control" />
                            <span asp-validation-for="NetWeight" class="text-danger"></span>
                        </div>
                    </div>

                    

                    <!-- Purch Unit Of Measure -->
                    <div class="row mt-2 purch-unit-of-measure">
                        <label class="col-12 col-sm-4 col-form-label">Purch Unit Of Measure</label>
                        <div class="col-12 col-sm-8">
                            <select asp-for="PurchUnitOfMeasure"
                                    asp-items="@(new SelectList(Model.DropDownData.UnitOfMeasures, "Code", "Name"))"
                                    class="form-select">
                                <option value="">-- Select --</option>
                            </select>
                            <span asp-validation-for="PurchUnitOfMeasure" class="text-danger"></span>
                        </div>
                    </div>

                </div>

            </div>

        </fieldset>

        <!-- ================= Item Specification ================= -->
        <fieldset id="itemSpeficationFieldset">
            <legend class="fw-bold">Item Specification</legend>

            <div class="row">

                <!-- Column 1 -->
                <div class="col-4 ">

                    <!-- TypeOfProduct -->
                    <div class="row mt-2">
                        <label class="col-12 col-sm-4 col-form-label">Type Of Product<span class="required-star">*</span></label>
                        <div class="col-12 col-sm-8">
                            <select asp-for="TypeOfProduct"
                                    asp-items="@(new SelectList(Model.DropDownData.TypeOfProducts, "Code", "Name"))"
                                    class="form-select" disabled>
                                <option value="">-- Select --</option>
                            </select>
                            <span asp-validation-for="TypeOfProduct" class="text-danger"></span>
                        </div>
                    </div>

                    <!-- Collection -->
                    <div class="row mt-2">
                        <label class="col-12 col-sm-4 col-form-label">Collection<span class="required-star">*</span></label>
                        <div class="col-12 col-sm-8">
                            <select asp-for="Collection"
                                    asp-items="@(new SelectList(Model.DropDownData.Collections, "Code", "Name"))"
                                    class="form-select">
                                <option value="">-- Select --</option>
                            </select>
                            <span asp-validation-for="Collection" class="text-danger"></span>
                        </div>
                    </div>

                    <!-- Surface Finish Glazes  -->
                    <div class="row mt-2">
                        <label class="col-12 col-sm-4 col-form-label">Surface Finish Or Glaze<span class="required-star">*</span></label>
                        <div class="col-12 col-sm-8">
                            <select asp-for="SurfaceFinishOrGlaze"
                                    asp-items="@(new SelectList(Model.DropDownData.SurfaceFinishGlazes, "Code", "Name"))"
                                    class="form-select">
                                <option value="">-- Select --</option>
                            </select>
                            <span asp-validation-for="SurfaceFinishOrGlaze" class="text-danger"></span>
                        </div>
                    </div>

                    <!-- GlazeEffect  -->
                    <div class="row mt-2">
                        <label class="col-12 col-sm-4 col-form-label">Glaze Effect<span class="required-star">*</span></label>
                        <div class="col-12 col-sm-8">
                            <select asp-for="GlazeEffect"
                                    asp-items="@(new SelectList(Model.DropDownData.GlazeEffects, "Code", "Name"))"
                                    class="form-select">
                                <option value="">-- Select --</option>
                            </select>
                            <span asp-validation-for="GlazeEffect" class="text-danger"></span>
                        </div>
                    </div>

                </div>

                <!-- Column 2 -->
                <div class="col-4">


                    <!-- Design Color -->
                    <div class="row mt-2 align-items-center">

                        <label class="col-12 col-sm-4 col-form-label">
                            Design Color<span class="required-star">*</span>
                        </label>
                        
                        <div class="col-12 col-sm-8">
                            <input type="text" asp-for="DesignColor" class="form-control mb-2" disabled />
                            <span asp-validation-for="DesignColor" class="text-danger"></span>
                        </div>

                    </div>

                    @* <!-- Colour Family -->
                    <div class="row mt-2">
                        <label class="col-12 col-sm-4 col-form-label">Colour Family</label>
                        <div class="col-12 col-sm-8">
                            <select asp-for="ColourFamily"
                                    asp-items="@(new SelectList(Model.DropDownData.ColourFamilies, "Code", "Name"))"
                                    class="form-select">
                                <option value="">-- Select --</option>
                            </select>
                            <span asp-validation-for="ColourFamily" class="text-danger"></span>
                        </div>
                    </div> *@

                    <!-- Type Of Tile -->
                    <div class="row mt-2">
                        <label class="col-12 col-sm-4 col-form-label">Type Of Tile<span class="required-star">*</span></label>
                        <div class="col-12 col-sm-8">
                            <select asp-for="TypeOfTile"
                                    asp-items="@(new SelectList(Model.DropDownData.TypeOfTiles, "Code", "Name"))"
                                    class="form-select">
                                <option value="">-- Select --</option>
                            </select>
                            <span asp-validation-for="TypeOfTile" class="text-danger"></span>
                        </div>
                    </div>

                    <!-- Body -->
                    <div class="row mt-2">
                        <label class="col-12 col-sm-4 col-form-label">Body<span class="required-star">*</span></label>
                        <div class="col-12 col-sm-8">
                            <select asp-for="Body"
                                    asp-items="@(new SelectList(Model.DropDownData.Bodies, "Code", "Name"))"
                                    class="form-select">
                                <option value="">-- Select --</option>
                            </select>
                            <span asp-validation-for="Body" class="text-danger"></span>
                        </div>
                    </div>

                    
                </div>

                <!-- Column 3 -->
                <div class="col-4">
                    <!-- PL Collection -->
                    <div class="row mt-2">
                        <label class="col-12 col-sm-4 col-form-label">PL Collection<span class="required-star">*</span></label>
                        <div class="col-12 col-sm-8">
                            <select asp-for="PLCollection"
                                    asp-items="@(new SelectList(Model.DropDownData.PLCollections, "Code", "Name"))"
                                    class="form-select">
                                <option value="">-- Select --</option>
                            </select>
                            <span asp-validation-for="PLCollection" class="text-danger"></span>
                        </div>
                    </div>
                    <!-- PL Colours -->
                    <div class="row mt-2">
                        <label class="col-12 col-sm-4 col-form-label">PL Colours<span class="required-star">*</span></label>
                        <div class="col-12 col-sm-8">
                            <select asp-for="PLColours"
                                    asp-items="@(new SelectList(Model.DropDownData.PLColours, "Code", "Name"))"
                                    class="form-select">
                                <option value="">-- Select --</option>
                            </select>
                            <span asp-validation-for="PLColours" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>
        </fieldset>

        <!-- ================= Cost and Posting ================= -->
        <fieldset id="costandPostingFieldset">
            <legend class="fw-bold">Cost & Posting  </legend>

            <div class="row">

                <!-- Column 1 -->
                <div class="col-4">

                    <!-- Costing Method -->
                    <div class="row mt-2">
                        <label class="col-12 col-sm-4 col-form-label">Costing Method<span class="required-star">*</span></label>
                        <div class="col-12 col-sm-8">
                            <select asp-for="CostingMethod"
                                    asp-items="@(new SelectList(Model.DropDownData.CostingMethods, "Code", "Name"))"
                                    class="form-select">
                                <option value="">-- Select --</option>
                            </select>
                            <span asp-validation-for="CostingMethod" class="text-danger"></span>
                        </div>
                    </div>

                    <!-- Inventory Posting Group -->
                    <div class="row mt-2">
                        <label class="col-12 col-sm-4 col-form-label"> Inventory Posting Group<span class="required-star">*</span></label>
                        <div class="col-12 col-sm-8">
                            <select asp-for="InventoryPostingGroup"
                                    asp-items="@(new SelectList(Model.DropDownData.InventoryPostingGroups, "Code", "Name"))"
                                    class="form-select">
                                <option value="">-- Select --</option>
                            </select>
                            <span asp-validation-for="InventoryPostingGroup" class="text-danger"></span>
