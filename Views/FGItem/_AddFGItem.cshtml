                    </div>

                    <!-- HSN/SAC Code -->
                    <div class="row mt-2">
                        <label class="col-12 col-sm-4 col-form-label">HSN/SAC Code<span class="required-star">*</span></label>
                        <div class="col-12 col-sm-8">
                            <select asp-for="HSNSACCode"
                                    class="form-select">
                                <option value="">--Select--</option>
                            </select>
                            <span asp-validation-for="HSNSACCode" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <!-- Column 3 -->
                <div class="col-4">
                    <!-- GST Credit -->
                    <div class="row mt-2">
                        <label class="col-12 col-sm-4 col-form-label">GST Credit<span class="required-star">*</span></label>
                        <div class="col-12 col-sm-8">
                            <select asp-for="GSTCredit"
                                    asp-items="@(new SelectList(Model.DropDownData.GSTCredits, "Code", "Name"))"
                                    class="form-select">
                                <option value="">--Select--</option>
                            </select>
                            <span asp-validation-for="GSTCredit" class="text-danger"></span>
                        </div>
                    </div>





                </div>
            </div>

        </fieldset>

        <fieldset id="gradeFieldset">
            <legend class="fw-bold">Grade Details</legend>

            <div class="grade-container mb-2">

                <!-- Grade List -->
                <div class="row g-3" id="gradeListContainer">

                    @for (int i = 0; i < Model.DropDownData.ItemGrades.Count; i++)
                    {
                        @if (i == 4)
                        {
                            <div class="col-12 extra-grade d-none">
                                <hr class="grade-divider" />
                            </div>
                        }

                        var extraClass = i >= 4 ? "extra-grade d-none" : "";

                        <div class="col-xl-2 col-lg-3 col-md-4 col-sm-6 @extraClass">

                            <label class="grade-card">

                                <input class="form-check-input grade-checkbox"
                                       type="checkbox"
                                       name="SelectedGrades"
                                       value="@Model.DropDownData.ItemGrades[i].Name"
                                       data-gradelinkcode="@Model.DropDownData.ItemGrades[i].GradeLinkCode"
                                       id="grade_@i" />

                                <span class="grade-text">
                                    @Model.DropDownData.ItemGrades[i].Name
                                </span>

                            </label>

                        </div>
                    }

                </div>

                <!-- More Button -->
                @if (Model.DropDownData.ItemGrades.Count > 6)
                {
                    <div class="text-end mt-3">

                        <button type="button"
                                class="btn btn-outline-secondary btn-sm"
                                id="btnShowMoreGrades">

                            More Grade

                        </button>

                    </div>
                }

                <!-- Preview Button -->
                <div class="text-end mt-4">

                    <button type="button"
                            class="btn btn-primary px-4 shadow-sm"
                            id="btnPreviewGrades">

                        <i class="fa fa-eye me-1"></i>
                        Preview

                    </button>

                </div>

            </div>

            <!-- Item Grade List -->
            <div class="table-responsive">
                <table class="table table-bordered align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Item Code</th>
                            <th>Brand</th>
                            <th>Grade</th>
                            <th>Grade Link Code</th>
                            <th>Sales Unit Of Measure</th>
                        </tr>
                    </thead>

                    <tbody id="grade-tbbody">
                    </tbody>
                </table>
            </div>
            <div class="row">

                <div class="col-12">
                    <span class="text-danger fw-bold">
                        Note:
                    </span>

                    <span class="text-danger">
                        These FG Numbers and Grade Link Codes are generated temporarily. In case the same item is created in the D365 at the same time, these numbers may change.
                    </span>
                </div>

            </div>
        </fieldset>

        <div class="action-buttons">
            <button type="button" class="btn btn-primary" id="btnSaveFGItemMaster">Save & Create In ERP</button>
        </div>
    </div>
</form>