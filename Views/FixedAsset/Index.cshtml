                 //                $('#tabContent').html(response);
                 //            },
                 //            error: function () {
                 //                alert('Error loading customer details');
                 //            }
                 //        });
            }
            else
            {
                loadDetails();
            }
        });

        function loadList() {
            editFixedAssetNo='';
            $.get(baseURL +'FixedAsset/FixedAssetList', function (data) {
                $("#tabContent").html(data);
            });
        }

        function loadDetails() {
            editFixedAssetNo='';
