@using Newtonsoft.Json

 
@{
    MenuPermissionModel? menu = null;

    var menuJson = Context.Session.GetString("MenuPermission");
    if (!string.IsNullOrEmpty(menuJson))
    {
        menu = JsonConvert.DeserializeObject<MenuPermissionModel>(menuJson);
    }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>ERP APP</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <!-- ===== NiceAdmin CSS ===== -->
    <link href="~/assets/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/assets/vendor/bootstrap-icons/bootstrap-icons.css" rel="stylesheet" />
    <link href="~/assets/css/style.css" rel="stylesheet" />

    <link rel="stylesheet" href="https://code.jquery.com/ui/1.13.2/themes/base/jquery-ui.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css">

    @RenderSection("Styles", required: false)
</head>

<body>

    <!-- ===== Header ===== -->
    <header id="header" class="header fixed-top d-flex align-items-center">

        <!-- Left -->
        <div class="d-flex align-items-center justify-content-between">
            <a asp-controller="Home" asp-action="Index" class="logo d-flex align-items-center">
                <span class="d-none d-lg-block">ERP APP</span>
            </a>
            <i class="bi bi-list toggle-sidebar-btn"></i>
        </div>

        <!-- Right -->
        <nav class="header-nav ms-auto">
            <ul class="d-flex align-items-center">

                <li class="nav-item dropdown pe-3">

                    <a class="nav-link nav-profile d-flex align-items-center pe-0"
                       href="#"
                       data-bs-toggle="dropdown">
                        <i class="bi bi-person-circle fs-4"></i>
                        <span class="d-none d-md-block dropdown-toggle ps-2">
                            @Context.Session.GetString("UserName")
                        </span>
                    </a>

                    <ul class="dropdown-menu dropdown-menu-end dropdown-menu-arrow profile">
                        <li class="dropdown-header">
                            <h6>@Context.Session.GetString("UserName")</h6>
                            <span>ERP User</span>
                        </li>

                        <li>
                            <hr class="dropdown-divider">
                        </li>

                        <li>
                            <a class="dropdown-item d-flex align-items-center"
                               asp-controller="Login"
                               asp-action="Logout">
                                <i class="bi bi-box-arrow-right"></i>
                                <span>Logout</span>
                            </a>
                        </li>

                    </ul>
                </li>

            </ul>
        </nav>

    </header>


    <!-- ===== Sidebar ===== -->
    <aside id="sidebar" class="sidebar">

        <ul class="sidebar-nav" id="sidebar-nav">

           

            @if (menu?.CustomerDetails == true)
            {
                <li class="nav-item">
                    <a class="nav-link collapsed" asp-controller="Customer" asp-action="Index">
                        <i class="bi bi-people"></i>
                        <span>Customer Master</span>
                    </a>
                </li>
            }

            @if (menu?.VendorDetails == true)
            {
                <li class="nav-item">
                    <a class="nav-link collapsed" asp-controller="Vendor" asp-action="Index">
                        <i class="bi bi-truck"></i>
                        <span>Vendor Master</span>
                    </a>
                </li>
            }

            @if (menu?.ItemMaster == true)
            {
                <li class="nav-item">
                    <a class="nav-link collapsed" asp-controller="Item" asp-action="Index">
                        <i class="bi bi-box"></i>
                        <span>Item Master</span>
                    </a>
                </li>
            }

            @if (menu?.FADetails == true)
            {
                <li class="nav-item">
                    <a class="nav-link collapsed" asp-controller="FixedAsset" asp-action="Index">
                        <i class="bi bi-building"></i>
                        <span>Fixed Asset</span>
                    </a>
                </li>
            }

            <li class="nav-item mt-3">
                <a class="nav-link collapsed text-danger" asp-controller="Login" asp-action="Logout">
                    <i class="bi bi-box-arrow-right"></i>
                    <span>Logout</span>
                </a>
            </li>

        </ul>

    </aside>

    <!-- ===== Main Content ===== -->
    <main id="main" class="main">
        @RenderBody()
    </main>

    <!-- ===== Footer ===== -->
    <footer id="footer" class="footer">
        <div class="copyright">
            © 2026 ERP APP
        </div>
    </footer>


    <!-- ===== Toast (Optional but Ready) ===== -->
    <div class="toast-container position-fixed top-0 end-0 p-3">
        <div id="appToast" class="toast border-0" role="alert">
            <div class="d-flex">
                <div class="toast-body" id="toastMessage"></div>
                <button type="button" class="btn-close me-2 m-auto" data-bs-dismiss="toast"></button>
            </div>
        </div>
    </div>

    <!-- ===== JS ===== -->
    <script src="~/assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/assets/js/main.js"></script>

    <!-- ✅ jQuery (NuGet) -->
    <script src="~/lib/jquery/dist/jquery.min.js" asp-append-version="true"></script>

    <!-- ✅ jQuery Validation -->
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

    <!-- ✅ jQuery UI (for autocomplete etc.) -->
   
    <script src="https://code.jquery.com/ui/1.13.2/jquery-ui.js"></script>

   

    <!-- ✅ DataTables JS -->
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>

    <script>

        var baseURL = '@Url.Content("~/")';

        function showToast(message, type = 'info', delay = 3000) {

            const toastEl = document.getElementById('appToast');
            const toastBody = document.getElementById('toastMessage');

            // reset classes
            toastEl.className = "toast border-0";

            // map types
            switch (type) {
                case "success":
                    toastEl.classList.add("text-bg-success");
                    break;
                case "error":
                case "danger":
                    toastEl.classList.add("text-bg-danger");
                    break;
                case "warning":
                    toastEl.classList.add("text-bg-warning");
                    break;
                case "info":
                default:
                    toastEl.classList.add("text-bg-info");
                    break;
            }

            toastBody.innerText = message;

            const toast = new bootstrap.Toast(toastEl, { delay: delay });
            toast.show();
        }
    </script>

    @if (TempData["ToastMessage"] != null)
    {
        <script>
            showToast(
                '@TempData["ToastMessage"]',
                '@(TempData["ToastType"] ?? "info")'
            );
        </script>
    }


    @RenderSection("Scripts", required: false)

</body>
</html>
